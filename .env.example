# ========================================================
# JARVIS ASSISTANT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# NEVER commit your .env file to Git!
# ========================================================

# LLM Provider Configuration (Jay - Core Brain)
# Supported: gemini, openai, groq, ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gemini-2.5-flash

# Backend & Server (Jay / Rohit)
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEBUG_MODE=True

# Voice Configuration (Aryan - Voice)
WAKE_WORD=hey jarvis
STT_MODEL=whisper-small
TTS_VOICE=en-US-GuyNeural
AUDIO_SAMPLE_RATE=16000

# Memory & Storage (Rohit - Memory)
DATABASE_PATH=memory/jarvis.db
CHROMA_PERSIST_DIR=memory/chroma_db

# Tools & System Automation (Abhijit - Tools)
ALLOW_DANGEROUS_COMMANDS=False
CONFIRM_DELETIONS=True
APP_SHORTCUTS_PATH=tools/app_shortcuts.json

# Vision & Multimodal Screen Understanding (Aryan - Vision)
GEMINI_MODEL=gemini-2.5-flash
VISION_PAUSED=0

