# ========================================================
# JARVIS ASSISTANT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# NEVER commit your .env file to Git!
# ========================================================

# Gemini is the only language model provider.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
LIVE_MODEL=models/gemini-3.1-flash-live-preview
# MIC_DEVICE=  # Optional: specific audio device name or index (e.g. 1 or Headphones)
LIVE_VOICE=Charon
MAX_HISTORY_ENTRIES=8

# Backend & Server (Jay / Rohit)
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEBUG_MODE=True

# Voice Configuration (Aryan - Voice)
WAKE_WORD=hey jarvis
STT_MODEL=whisper-small
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
AUDIO_SAMPLE_RATE=16000

# Memory & Storage (Rohit - Memory)
DATABASE_PATH=memory/jarvis.db
CHROMA_PERSIST_DIR=memory/chroma_db

# Tools & System Automation (Abhijit - Tools)
ALLOW_DANGEROUS_COMMANDS=False
CONFIRM_DELETIONS=True
APP_SHORTCUTS_PATH=tools/app_shortcuts.json

# Vision & Multimodal Screen Understanding (Aryan - Vision)
VISION_PAUSED=0


# --- Madhuri: voice (STT) ---
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_VOICE_EN=en-IN-PrabhatNeural
TTS_VOICE_HI=hi-IN-MadhurNeural
TTS_VOICE_MR=mr-IN-ManoharNeural

# --- Trupti: Messaging ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_OWNER_ID=your_telegram_chat_id_here
